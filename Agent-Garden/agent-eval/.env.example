# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Use a proxy
# HTTP_PROXY=http://localhost:8080
# HTTPS_PROXY=http://localhost:8080

# Model configuration
OPENAI_JUDGE_MODEL=gpt-4o
OPENAI_MUTATOR_MODEL=gpt-4o-mini

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Evaluation settings
DEFAULT_CATEGORIES=ASI01,ASI02,ASI06
DEFAULT_N_VARIANTS=5
DEFAULT_MAX_ATTACKS=50
